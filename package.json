{
  "name": "playwright-automation-framework",
  "version": "1.0.0",
  "description": "Unified Playwright Test Automation Framework - UI (OrangeHRM) & API (Petstore Swagger)",
  "scripts": {
    "test": "npx playwright test",
    "test:ui": "npx playwright test --project=ui-tests",
    "test:api": "npx playwright test --project=api-tests",
    "test:headed": "npx playwright test --project=ui-tests --headed",
    "report": "npx playwright show-report test-results/html-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "typescript": "^5.3.0",
    "winston": "^3.11.0"
  }
}
